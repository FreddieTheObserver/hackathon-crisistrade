generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Marketplace Trades (owner: La Yaung Phyo) ──────────────────────
model Trade {
  id                String   @id @default(cuid())
  title             String
  ownerName         String                          // creator's displayName (denormalized for display)
  userId            String   @default("")           // creator's User.id (plain ref, no FK)
  offering          String                          // offer + qty, e.g. "Rice (20 kg)"
  wanting           String                          // want + qty, e.g. "Blankets (5)"
  itemType          String                          // water|food|medicine|batteries|shelter|tools|other
  urgency           String                          // low|medium|high|critical
  area              String                          // location, e.g. "Kathmandu, Bagmati"
  contact           String                          // phone / contact (required)
  note              String?
  photoUrl          String?                         // /uploads/<file>, set by multer
  status            String   @default("available")  // available|pending|completed|unavailable
  counterparty      String?                         // required when status -> completed
  reputationAwarded Boolean  @default(false)        // one-time idempotency guard
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Trader {
  id               String   @id @default(cuid())
  name             String   @unique                 // by-name link to Trade.ownerName / counterparty (no FK)
  userId           String?  @unique                 // links reputation to a User (null for by-name counterparties)
  reputationPoints Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Donations (owner: Eaint Myat Noe) ──────────────────────────────
model Donation {
  id          Int          @id @default(autoincrement())
  title       String
  item        String
  quantity    String
  category    String
  location    String
  availableAt String
  photoUrl    String?
  note        String?
  contact     String
  status      String   @default("AVAILABLE")
  ownerId     String
  ownerName   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Emergency Requests (owner: Felice Christiara Median Putri) ──────
model EmergencyRequest {
  id        String   @id @default(cuid())
  title     String
  need      String
  location  String
  urgency   String
  status    String   @default("Open")
  note      String   @default("")
  contact   String
  photoUrl  String?
  isOwner   Boolean  @default(false)
  userId    String   @default("")                    // creator's User.id (plain ref, no FK)
  ownerName String   @default("")                     // creator's displayName (denormalized)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Safe Exchange Points (owner: Saw Thet Wai Yan) ─────────────────
model ExchangePoint {
  id           String   @id @default(cuid())
  placeName    String
  area         String
  openTime     String
  notes        String   @default("")
  contactNotes String   @default("")
  userId       String   @default("")                  // creator's User.id (plain ref, no FK)
  ownerName    String   @default("")                  // creator's displayName (denormalized)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Auth (shared, integration phase: branch share/auth) ────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
